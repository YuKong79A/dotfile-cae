// NyxNiri fastfetch layout, adapted to follow the Caelestia palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "#c6c6c6",
            "2": "#9d9d9d",
            "3": "#f7f7f7"
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ",
        "color": "#e5e5e5",
        "constants": [
            "\u001b[38;2;198;198;198m",
            "\u001b[38;2;157;157;157m",
            "\u001b[38;2;247;247;247m",
            "\u001b[38;2;212;212;212m",
            "\u001b[38;2;212;212;212m",
            "\u001b[38;2;216;218;221m"
        ]
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {$1} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {$2}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {$3}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {$4}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {$5} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {$6}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {$1} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {$2} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {$3}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {$4}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {$5} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {$6}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {$3} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
