// NyxNiri fastfetch layout, adapted to follow the Caelestia palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "#f5ba95",
            "2": "#e5bfa8",
            "3": "#fff9ec"
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ",
        "color": "#f8e1d5",
        "constants": [
            "\u001b[38;2;245;186;149m",
            "\u001b[38;2;229;191;168m",
            "\u001b[38;2;255;249;236m",
            "\u001b[38;2;239;181;143m",
            "\u001b[38;2;243;205;182m",
            "\u001b[38;2;236;221;153m"
        ]
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {$1} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {$2}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {$3}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {$4}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {$5} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {$6}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {$1} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {$2} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {$3}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {$4}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {$5} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {$6}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {$3} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
