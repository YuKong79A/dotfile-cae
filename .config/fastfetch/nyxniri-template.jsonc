// NyxNiri fastfetch layout, adapted to follow the Caelestia palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "__PRIMARY__",
            "2": "__SECONDARY__",
            "3": "__TERTIARY__"
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ",
        "color": "__TEXT__",
        "constants": [
            "__C1__",
            "__C2__",
            "__C3__",
            "__C4__",
            "__C5__",
            "__C6__"
        ]
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {$1} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {$2}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {$3}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {$4}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {$5} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {$6}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {$1} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {$2} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {$3}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {$4}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {$5} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {$6}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {$3} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
