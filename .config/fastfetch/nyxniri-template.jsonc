// NyxNiri fastfetch layout, adapted to follow the Caelestia palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "__PRIMARY__",
            "2": "__SECONDARY__",
            "3": "__TERTIARY__"
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "key": {
            "paddingLeft": 5
        },
        "separator": " ",
        "color": "__TEXT__",
        "constants": [
            "__C1__",
            "__C2__",
            "__C3__",
            "__C4__",
            "__C5__",
            "__C6__"
        ]
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {$1} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {$2}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {$3}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {$4} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {$5} OS Age  {#keys}│",
            "type": "disk",
            "folders": "/",
            "format": "{days} days"
        },
        {
            "key": "│ {$6}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {$1}󰏖 apps    {#keys}│",
            "type": "packages",
            "format": "{all}"
        },
        {
            "key": "│ {$2}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {$3} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {$4} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {$5} font    {#keys}│",
            "type": "terminalfont"
        },
        {
            "key": "│ {$6}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {$1} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {$2}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {$3}󰝚 playing {#keys}│",
            "type": "media",
            "format": "{?artist}{artist} - {?}{title}"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {$3} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
