#!/usr/bin/env bash
set -euo pipefail

font_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/GoogleSansFlex"
font_file="$font_dir/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf"
font_url="https://fonts.gstatic.com/s/googlesansflex/v22/t5t7IQcYNIWbFgDgAAzZ34auoVyXipusfhcat2c.ttf"
font_sha256="c6d53424121196b81de816b8daccf200e285dd506df43766db3d7e8cdf06ee30"
temp_file="$(mktemp)"
trap 'rm -f "$temp_file"' EXIT

mkdir -p "$font_dir"
curl -fL "$font_url" -o "$temp_file"
printf '%s  %s\n' "$font_sha256" "$temp_file" | sha256sum --check --status
install -m 0644 "$temp_file" "$font_file"
fc-cache -f "$font_dir"
fc-match GoogleSansFlex
