#!/bin/sh
# Load the VapourSynth-enabled libmpv for Tsukimi.
svp_root="$HOME/.local/opt/svp4"
if ! pgrep -u "$(id -u)" -x SVPManager >/dev/null 2>&1; then
    "$svp_root/SVPManager" >/dev/null 2>&1 &
fi
export VSSCRIPT_PATH="$svp_root/mpv/libvapoursynth-script.so.0"
export PYTHONPATH="$svp_root/mpv/python${PYTHONPATH:+:$PYTHONPATH}"
mpv_lib="$HOME/.local/opt/mpv-svp/lib"
export LD_LIBRARY_PATH="$mpv_lib:$svp_root/mpv${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /usr/bin/tsukimi "$@"
